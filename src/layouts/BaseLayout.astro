---
/**
 * 基础布局：PaperMod 的 HTML 骨架
 *   <html data-theme="auto|light|dark">  主题切换用 data-theme 属性（不是 class）
 *   <body id="top" class="list">         列表页加 .list（底色为 --code-bg，卡片才浮起来）
 *   <header class="header"> / <main class="main"> / <footer class="footer">
 */
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import favicon from '../assets/favicon.svg';
import { siteConfig } from '../../site.config.ts';
import '../styles/papermod.css';
import '../styles/site.css';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  type?: 'website' | 'article';
  image?: string;
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  author?: string;
  noindex?: boolean;
  /** 列表类页面（首页 / 文章列表 / 分类 / 标签）加 .list，与主题一致 */
  listPage?: boolean;
}

const {
  title,
  description,
  path,
  type = 'website',
  image,
  pubDate,
  updatedDate,
  tags,
  author,
  noindex,
  listPage = false,
} = Astro.props;
---

<!doctype html>
<html lang={siteConfig.site.lang} dir="auto" data-theme="auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {/* 站点图标：SVG 里用 ☕️ 文本，由浏览器用系统彩色 emoji 字体渲染。
        走 import 而不是放 public/，是为了让 Astro 把文件名带上内容哈希：
        /favicon.svg 这种固定路径会被浏览器长期缓存，改了图标也看不到。
        iOS 的主屏图标只认 PNG，而栅格化彩色 emoji 意味着在仓库里分发字体字形数据，
        所以不提供 PNG，iOS 会退回站点截图。 */}
    <link rel="icon" type="image/svg+xml" href={favicon.src} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1d1e20" media="(prefers-color-scheme: dark)" />

    <SEO
      title={title}
      description={description}
      path={path}
      type={type}
      image={image}
      pubDate={pubDate}
      updatedDate={updatedDate}
      tags={tags}
      author={author}
      noindex={noindex}
    />

    {/* 首屏恢复主题：与 PaperMod 的 head.html 完全一致（localStorage 键 pref-theme） */}
    <script is:inline>
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem('pref-theme');
        } catch (e) {
          /* 隐私模式忽略 */
        }
        if (stored === 'dark') {
          document.documentElement.dataset.theme = 'dark';
        } else if (stored === 'light') {
          document.documentElement.dataset.theme = 'light';
        } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          document.documentElement.dataset.theme = 'dark';
        } else {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>

    <slot name="head" />
  </head>

  <body id="top" class={listPage ? 'list' : undefined}>
    <a class="skip-link" href="#main">跳到正文</a>
    <Header />
    <main class="main" id="main">
      <slot />
    </main>
    <Footer />
    <slot name="scripts" />
  </body>
</html>
