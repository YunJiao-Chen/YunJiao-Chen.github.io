---
/**
 * 基础布局：PaperMod 的 HTML 骨架
 *   <html data-theme="auto|light|dark">  主题切换用 data-theme 属性（不是 class）
 *   <body id="top" class="list">         列表页加 .list（底色为 --code-bg，卡片才浮起来）
 *   <header class="header"> / <main class="main"> / <footer class="footer">
 */
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
// .ico 不像 png/svg 那样带图片元数据，Vite 直接返回 URL 字符串（没有 .src）
import faviconIcoSrc from '../assets/favicon.ico';
import favicon16 from '../assets/favicon-16x16.png';
import favicon32 from '../assets/favicon-32x32.png';
import faviconSource from '../assets/favicon.png';
import appleTouchIcon from '../assets/apple-touch-icon.png';
import { siteConfig } from '../../site.config.ts';
import '../styles/papermod.css';
import '../styles/site.css';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  type?: 'website' | 'article';
  image?: string;
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  author?: string;
  noindex?: boolean;
  /** 列表类页面（首页 / 文章列表 / 分类 / 标签）加 .list，与主题一致 */
  listPage?: boolean;
}

const {
  title,
  description,
  path,
  type = 'website',
  image,
  pubDate,
  updatedDate,
  tags,
  author,
  noindex,
  listPage = false,
} = Astro.props;
---

<!doctype html>
<html lang={siteConfig.site.lang} dir="auto" data-theme="auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {/* 站点图标：一杯咖啡（Fluent Emoji 的 3D 版，MIT）。
        源文件是 256×256 光栅图，所以没有矢量图标，靠这几个覆盖各种场合：
        ico（16/32/48/64，标签页与 Windows 任务栏）、
        16/32 png（显式尺寸，部分浏览器更认）、
        apple-touch（iOS 主屏）、256 png（高分辨率屏，比 ico 里最大那档更清楚）。
        指向的都是带内容哈希的那份（走 import，Astro 自动加哈希）：固定路径会被
        浏览器长期缓存，换了图标用户也看不到（这个坑踩过一次）。
        public/ 下另有 /favicon.ico 与 /apple-touch-icon.png 两份同内容副本，给不看
        <link>、直接按约定取图的地方（书签栏、iOS、RSS 阅读器）兜底；自检里有一条比对。
        改图形：换掉 src/assets/favicon.png 再跑 scripts/make-icons.sh。 */}
    <link rel="icon" href={faviconIcoSrc} />
    <link rel="icon" type="image/png" sizes="16x16" href={favicon16.src} />
    <link rel="icon" type="image/png" sizes="32x32" href={favicon32.src} />
    <link rel="apple-touch-icon" sizes="180x180" href={appleTouchIcon.src} />
    <link rel="icon" type="image/png" sizes="256x256" href={faviconSource.src} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1d1e20" media="(prefers-color-scheme: dark)" />

    <SEO
      title={title}
      description={description}
      path={path}
      type={type}
      image={image}
      pubDate={pubDate}
      updatedDate={updatedDate}
      tags={tags}
      author={author}
      noindex={noindex}
    />

    {/* 首屏恢复主题：与 PaperMod 的 head.html 完全一致（localStorage 键 pref-theme） */}
    <script is:inline>
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem('pref-theme');
        } catch (e) {
          /* 隐私模式忽略 */
        }
        if (stored === 'dark') {
          document.documentElement.dataset.theme = 'dark';
        } else if (stored === 'light') {
          document.documentElement.dataset.theme = 'light';
        } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          document.documentElement.dataset.theme = 'dark';
        } else {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>

    <slot name="head" />
  </head>

  <body id="top" class={listPage ? 'list' : undefined}>
    <a class="skip-link" href="#main">跳到正文</a>
    <Header />
    <main class="main" id="main">
      <slot />
    </main>
    <Footer />
    <slot name="scripts" />
  </body>
</html>
