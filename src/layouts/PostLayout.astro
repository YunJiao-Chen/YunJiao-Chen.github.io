---
/**
 * 文章布局：与 PaperMod 的 single.html 结构一致
 *   article.post-single
 *     header.post-header（面包屑 + h1.post-title + .post-description + .post-meta）
 *     details.toc（ShowToc）
 *     div.post-content.md-content
 *     footer.post-footer（ul.post-tags + nav.paginav 上一篇 / 下一篇）
 *   评论区接在 article 之后（主题里 comments 也在 post-single 内，这里放到页尾更易读）
 */
import type { MarkdownHeading } from 'astro';

import BaseLayout from './BaseLayout.astro';
import TOC from '../components/TOC.astro';
import Comments from '../components/Comments.astro';
import WeChatExport from '../components/WeChatExport.astro';
import Icon from '../components/Icon.astro';
import { getAdjacentPosts, postMeta, postPath, type Post } from '../lib/posts.ts';
import { formatDate } from '../lib/utils.ts';
import { siteConfig, withBase } from '../../site.config.ts';

interface Props {
  post: Post;
  headings: MarkdownHeading[];
}

const { post, headings } = Astro.props;
const meta = postMeta(post);
const { newer, older } = await getAdjacentPosts(post.id);

/* 与主题的 post_meta.html 一致：不换行空格 + 中点拼接 */
const metaParts = [
  `<span title="${new Date(post.data.pubDate).toISOString()}">${formatDate(post.data.pubDate)}</span>`,
  siteConfig.features.readingTime ? `<span>${meta.reading.label}</span>` : '',
].filter(Boolean);
const metaHtml = metaParts.join('&nbsp;&middot;&nbsp;');
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  path={postPath(post)}
  type="article"
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  tags={post.data.tags}
  author={post.data.wechat?.author ?? siteConfig.author.name}
>
  <article class="post-single">
    <header class="post-header">
      <nav class="breadcrumbs" role="navigation" aria-label="面包屑">
        <a href={withBase('/')}>首页</a>
        <Icon name="chevron-right" size={14} />
        <a href={withBase('/posts/')}>文章</a>
        <Icon name="chevron-right" size={14} />
        <a href={withBase(`/categories/${meta.category.slug}/`)}>{meta.category.name}</a>
        <Icon name="chevron-right" size={14} />
      </nav>

      <h1 class="post-title entry-hint-parent">{post.data.title}</h1>

      <div class="post-description">{post.data.description}</div>

      <div class="post-meta">
        <Fragment set:html={metaHtml} />
        {
          post.data.updatedDate && (
            <span>&nbsp;&middot;&nbsp;更新于 {formatDate(post.data.updatedDate)}</span>
          )
        }
      </div>
    </header>

    {siteConfig.features.toc && <TOC headings={headings} />}

    <div class="post-content md-content" data-wechat-article>
      <slot />
    </div>

    <div class="post-actions">
      <WeChatExport post={post} />
      <button type="button" class="btn" data-copy-link data-wechat-ignore>
        <Icon name="link" size={14} /> 复制链接
      </button>
    </div>

    <footer class="post-footer">
      {
        post.data.tags.length > 0 && (
          <ul class="post-tags" data-wechat-ignore>
            {post.data.tags.map((tag) => (
              <li>
                <a href={withBase(`/tags/${encodeURIComponent(tag)}/`)}>{tag}</a>
              </li>
            ))}
          </ul>
        )
      }

      {
        siteConfig.features.postNav && (
          <nav class="paginav" aria-label="上下篇">
            {newer && (
              <a class="prev" href={withBase(postPath(newer))}>
                <span class="title">« 上一篇</span>
                <span>{newer.data.title}</span>
              </a>
            )}
            {older && (
              <a class="next" href={withBase(postPath(older))}>
                <span class="title">下一篇 »</span>
                <span>{older.data.title}</span>
              </a>
            )}
          </nav>
        )
      }
    </footer>
  </article>

  <Comments />
</BaseLayout>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-link]');
  const copyButtonHtml = copyButton?.innerHTML ?? '';
  copyButton?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(window.location.href);
      copyButton.textContent = '链接已复制';
      setTimeout(() => {
        if (copyButton) copyButton.innerHTML = copyButtonHtml;
      }, 1600);
    } catch {
      /* 剪贴板不可用：用户可手动复制地址栏 */
    }
  });
</script>
