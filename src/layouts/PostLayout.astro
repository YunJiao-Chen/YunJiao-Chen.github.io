---
/**
 * 文章布局（PaperMod）：标题区 + 可折叠目录 + 正文 + 操作区 + 标签 / 上下篇 / 相关 / 评论
 */
import type { MarkdownHeading } from 'astro';

import BaseLayout from './BaseLayout.astro';
import TOC from '../components/TOC.astro';
import Comments from '../components/Comments.astro';
import WeChatExport from '../components/WeChatExport.astro';
import Icon from '../components/Icon.astro';
import PostEntry from '../components/PostEntry.astro';
import { getAdjacentPosts, getRelatedPosts, postMeta, postPath, type Post } from '../lib/posts.ts';
import { formatDate } from '../lib/utils.ts';
import { siteConfig, withBase } from '../../site.config.ts';
import '../styles/prose.css';

interface Props {
  post: Post;
  headings: MarkdownHeading[];
}

const { post, headings } = Astro.props;
const meta = postMeta(post);

const [{ newer, older }, related] = await Promise.all([
  getAdjacentPosts(post.id),
  getRelatedPosts(post, 3),
]);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  path={postPath(post)}
  type="article"
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  tags={post.data.tags}
  author={post.data.wechat?.author ?? siteConfig.author.name}
  containerClass="container container--main"
>
  <nav class="breadcrumb" aria-label="面包屑">
    <a href={withBase('/')}>首页</a>
    <span aria-hidden="true">/</span>
    <a href={withBase('/posts/')}>文章</a>
    <span aria-hidden="true">/</span>
    <a href={withBase(`/categories/${meta.category.slug}/`)}>{meta.category.name}</a>
  </nav>

  <header class="post-header">
    <h1 class="post-header__title">{post.data.title}</h1>
    <p class="post-header__dek">{post.data.description}</p>
    <div class="meta post-header__meta">
      <span>
        <Icon name="calendar" size={14} />
        <time datetime={new Date(post.data.pubDate).toISOString()}>
          {formatDate(post.data.pubDate)}
        </time>
      </span>
      {post.data.updatedDate && <span>更新于 {formatDate(post.data.updatedDate)}</span>}
      {siteConfig.features.readingTime && <span>{meta.reading.label}</span>}
      {post.data.series && <span>系列 {post.data.series}</span>}
    </div>
  </header>

  {siteConfig.features.toc && <TOC headings={headings} />}

  <article class="prose" data-wechat-article>
    <slot />
  </article>

  <div class="post-actions">
    <WeChatExport post={post} />
    <button type="button" class="btn btn--ghost" data-copy-link data-wechat-ignore>
      <Icon name="link" size={15} /> 复制链接
    </button>
    {
      siteConfig.wechat.showCopyButton && meta.wechatEnabled && (
        <span class="post-actions__note">
          「复制到公众号」会把排版转成行内样式后写入剪贴板，直接粘到公众号编辑器即可。
        </span>
      )
    }
  </div>

  <footer class="post-footer">
    {
      post.data.tags.length > 0 && (
        <div class="post-tags" data-wechat-ignore>
          {post.data.tags.map((tag) => (
            <a class="chip" href={withBase(`/tags/${encodeURIComponent(tag)}/`)}>
              #{tag}
            </a>
          ))}
        </div>
      )
    }

    {
      siteConfig.features.postNav && (
        <nav class="post-nav" aria-label="上下篇">
          <div class="post-nav__item">
            <p class="post-nav__label">上一篇</p>
            {newer ? (
              <p class="post-nav__title">
                <a href={withBase(postPath(newer))}>{newer.data.title}</a>
              </p>
            ) : (
              <p class="post-nav__title post-nav__title--empty">已经是最新一篇</p>
            )}
          </div>
          <div class="post-nav__item post-nav--right">
            <p class="post-nav__label">下一篇</p>
            {older ? (
              <p class="post-nav__title">
                <a href={withBase(postPath(older))}>{older.data.title}</a>
              </p>
            ) : (
              <p class="post-nav__title post-nav__title--empty">已经是最早一篇</p>
            )}
          </div>
        </nav>
      )
    }

    {
      related.length > 0 && (
        <section>
          <h2 class="subhead">相关文章</h2>
          {related.map((item) => <PostEntry post={item} />)}
        </section>
      )
    }

    <Comments />
  </footer>
</BaseLayout>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-link]');
  const copyButtonHtml = copyButton?.innerHTML ?? '';
  copyButton?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(window.location.href);
      copyButton.textContent = '链接已复制';
      setTimeout(() => {
        if (copyButton) copyButton.innerHTML = copyButtonHtml;
      }, 1600);
    } catch {
      /* 剪贴板不可用：用户可手动复制地址栏 */
    }
  });
</script>
