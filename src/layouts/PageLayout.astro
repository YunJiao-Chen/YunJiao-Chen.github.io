---
/**
 * 页面布局，对齐 PaperMod 的两种页面：
 *   kind = 'list'（默认）：列表与归档类页面，body.list + header.page-header > h1
 *   kind = 'page'：内容页（关于 / FAQ / 404），article.post-single + h1.post-title
 * prose = true 时把内容包进 div.post-content.md-content（正文型页面）；
 *   about 这种自带两栏布局的页面传 false，自己在内部包 md-content。
 * 两个分支各自直接输出，不额外套包装 div，产物结构与主题模板一一对应。
 */
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  path?: string;
  kind?: 'list' | 'page';
  prose?: boolean;
  noindex?: boolean;
}

const {
  title,
  description,
  path,
  kind = 'list',
  prose = false,
  noindex = false,
} = Astro.props;

const isPage = kind === 'page';
---

<BaseLayout title={title} description={description} path={path} noindex={noindex} listPage={!isPage}>
  {
    isPage ? (
      <article class="post-single">
        <header class="post-header">
          <h1 class="post-title entry-hint-parent">{title}</h1>
          {description && <div class="post-description">{description}</div>}
          <slot name="head-extra" />
        </header>
        {prose ? (
          <div class="post-content md-content">
            <slot />
          </div>
        ) : (
          <slot />
        )}
      </article>
    ) : (
      <>
        <header class="page-header">
          <h1>{title}</h1>
          {description && <div class="post-description">{description}</div>}
          <slot name="head-extra" />
        </header>
        {prose ? (
          <div class="post-content md-content">
            <slot />
          </div>
        ) : (
          <slot />
        )}
      </>
    )
  }
</BaseLayout>
