---
/**
 * 独立页面布局（关于 / 归档页 / 404）
 * PaperMod 风格：导航宽 1024px，内容列 720px，都居中
 */
import BaseLayout from './BaseLayout.astro';
import '../styles/prose.css';

interface Props {
  title: string;
  description?: string;
  path?: string;
  prose?: boolean;
  noindex?: boolean;
}

const { title, description, path, prose = false, noindex = false } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  noindex={noindex}
  containerClass="container container--main"
>
  <header class="page-head">
    <h1 class="page-head__title">{title}</h1>
    {description && <p class="page-head__desc">{description}</p>}
    <slot name="head-extra" />
  </header>

  <div class={prose ? 'prose' : ''}>
    <slot />
  </div>
</BaseLayout>
