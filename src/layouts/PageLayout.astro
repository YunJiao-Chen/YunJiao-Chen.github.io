---
/**
 * 页面布局：与 PaperMod 的 list.html 头部一致
 *   header.page-header > h1 + div.post-description
 *   prose = true 时把内容包进 div.post-content.md-content（关于页、404 这类文本页）
 *   listPage = true 时给 body 加 .list（列表页底色，卡片才浮起来）
 */
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  path?: string;
  prose?: boolean;
  listPage?: boolean;
  noindex?: boolean;
}

const {
  title,
  description,
  path,
  prose = false,
  listPage = false,
  noindex = false,
} = Astro.props;
---

<BaseLayout title={title} description={description} path={path} noindex={noindex} listPage={listPage}>
  <header class="page-header">
    <h1>{title}</h1>
    {description && <div class="post-description">{description}</div>}
    <slot name="head-extra" />
  </header>

  {prose ? <div class="post-content md-content"><slot /></div> : <slot />}
</BaseLayout>
