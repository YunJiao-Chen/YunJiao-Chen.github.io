---
/**
 * 标签场：与 PaperMod 的 terms.html 一致（ul.terms-tags）
 */
import { withBase } from '../../site.config.ts';

interface Props {
  tags: { name: string; count: number; slug: string }[];
  limit?: number;
  showCount?: boolean;
}

const { tags, limit = 0, showCount = true } = Astro.props;
const list = limit > 0 ? tags.slice(0, limit) : tags;
---

<ul class="terms-tags">
  {
    list.map((tag) => (
      <li>
        <a href={withBase(`/tags/${encodeURIComponent(tag.slug)}/`)}>
          {tag.name}
          {showCount && <sup>{tag.count}</sup>}
        </a>
      </li>
    ))
  }
</ul>
