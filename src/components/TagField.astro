---
/**
 * 标签场：纯文字 + hairline，不用一排胶囊（避免视觉噪音）
 */
import { withBase } from '../../site.config.ts';

interface Props {
  tags: { name: string; count: number; slug: string }[];
  limit?: number;
  showCount?: boolean;
}

const { tags, limit = 0, showCount = true } = Astro.props;
const list = limit > 0 ? tags.slice(0, limit) : tags;
---

<div class="tag-field">
  {
    list.map((tag) => (
      <a class="tag-field__item" href={withBase(`/tags/${encodeURIComponent(tag.slug)}/`)}>
        {tag.name}
        {showCount && <span class="tag-field__count">{tag.count}</span>}
      </a>
    ))
  }
</div>
