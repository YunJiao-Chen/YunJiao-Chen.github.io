---
/**
 * SEO 元信息：title / description / canonical / OG / Twitter / JSON-LD
 */
import { siteConfig, absoluteUrl, withBase } from '../../site.config.ts';

interface Props {
  title?: string;
  description?: string;
  /** 页面路径，用于 canonical（如 '/blog/xxx/'） */
  path?: string;
  type?: 'website' | 'article';
  image?: string;
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  author?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = siteConfig.site.description,
  path = Astro.url.pathname.replace(siteConfig.site.base, '/') || '/',
  type = 'website',
  image,
  pubDate,
  updatedDate,
  tags = [],
  author = siteConfig.author.name,
  noindex = false,
  jsonLd,
} = Astro.props;

/**
 * 浏览器标签页标题：`<页面标签> | yjchen`
 * 分隔符用竖线（与参考站一致）；页面标签要和顶栏菜单里的写法一致
 * （Posts / Archive / Tags / FAQ …），自检里有一条会逐个核对导航页的标题。
 * 标题里已经含站点名时不再追加后缀，避免出现「关于 yjchen | yjchen」。
 */
const pageTitle = title
  ? title.includes(siteConfig.site.title)
    ? title
    : `${title} | ${siteConfig.site.title}`
  : siteConfig.site.title;

const canonical = absoluteUrl(path);
const ogImage = image ? absoluteUrl(image) : `${absoluteUrl('/og-default.svg')}`;

const blogPosting = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title ?? siteConfig.site.title,
  description,
  inLanguage: siteConfig.site.lang,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  url: canonical,
  image: [ogImage],
  author: {
    '@type': 'Person',
    name: author,
    url: absoluteUrl('/about/'),
  },
  publisher: {
    '@type': 'Person',
    name: siteConfig.author.name,
  },
  ...(pubDate ? { datePublished: new Date(pubDate).toISOString() } : {}),
  ...(updatedDate ? { dateModified: new Date(updatedDate).toISOString() } : {}),
  ...(tags.length ? { keywords: tags.join(', ') } : {}),
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.site.title,
  description: siteConfig.site.description,
  url: absoluteUrl('/'),
  inLanguage: siteConfig.site.lang,
  author: { '@type': 'Person', name: siteConfig.author.name },
};

const blocks = jsonLd
  ? Array.isArray(jsonLd)
    ? jsonLd
    : [jsonLd]
  : type === 'article'
    ? [blogPosting]
    : [website];
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex,nofollow" />}
{tags.length > 0 && <meta name="keywords" content={tags.join(', ')} />}
<meta name="author" content={author} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteConfig.site.title} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content={siteConfig.site.locale} />
{pubDate && <meta property="article:published_time" content={new Date(pubDate).toISOString()} />}
{updatedDate && <meta property="article:modified_time" content={new Date(updatedDate).toISOString()} />}
{tags.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter / 社交卡片 -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- 订阅 -->
{siteConfig.features.rss && <link rel="alternate" type="application/rss+xml" title={`${siteConfig.site.title} · RSS`} href={withBase('/rss.xml')} />}

<script is:inline type="application/ld+json" set:html={JSON.stringify(blocks.length === 1 ? blocks[0] : blocks)} />
