---
/**
 * 顶栏：品牌 / 导航（桌面单行）/ 订阅 / 搜索 / 主题切换
 */
import Icon from './Icon.astro';
import SearchDialog from './SearchDialog.astro';
import { siteConfig, withBase } from '../../site.config.ts';

const { pathname } = Astro.url;
const base = siteConfig.site.base.replace(/\/$/, '');

const normalize = (value: string) => {
  const stripped = value.startsWith(base) ? value.slice(base.length) : value;
  return stripped.endsWith('/') ? stripped : `${stripped}/`;
};

const currentPath = normalize(pathname);
const isActive = (href: string) => {
  const target = normalize(href);
  if (target === '/') return currentPath === '/';
  return currentPath.startsWith(target) || currentPath === target.replace(/\/$/, '');
};

const initials = siteConfig.author.name.slice(0, 1).toUpperCase();
---

<header class="header">
  <div class="container header__inner">
    <a class="brand" href={withBase('/')} aria-label={`${siteConfig.site.title} 首页`}>
      <span class="brand__mark" aria-hidden="true">{initials}</span>
      <span class="brand__text">
        <span class="brand__title">{siteConfig.site.title}</span>
        <span class="brand__subtitle">{siteConfig.site.subtitle}</span>
      </span>
    </a>

    <nav class="nav" data-nav aria-label="主导航">
      {
        siteConfig.nav.map((item) => (
          <a
            class="nav__link"
            href={withBase(item.href)}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header__actions">
      {
        siteConfig.features.rss && (
          <a class="icon-btn" href={withBase('/rss.xml')} aria-label="RSS 订阅" title="RSS 订阅">
            <Icon name="rss" size={17} />
          </a>
        )
      }
      {siteConfig.features.search && <SearchDialog />}
      {
        siteConfig.features.darkMode && (
          <button type="button" class="icon-btn" data-theme-toggle aria-label="切换深浅色主题">
            <span class="theme-icon theme-icon--sun" aria-hidden="true"><Icon name="sun" size={17} /></span>
            <span class="theme-icon theme-icon--moon" aria-hidden="true"><Icon name="moon" size={17} /></span>
          </button>
        )
      }
      <button type="button" class="icon-btn nav-toggle" data-nav-toggle aria-label="打开菜单" aria-expanded="false">
        <Icon name="menu" size={19} />
      </button>
    </div>
  </div>
</header>

<style>
  .theme-icon {
    display: none;
    line-height: 0;
  }

  :global(html:not(.dark)) .theme-icon--moon {
    display: inline-flex;
  }

  :global(html.dark) .theme-icon--sun {
    display: inline-flex;
  }
</style>

<script>
  /* 主题切换：写入 localStorage，首屏由 <head> 内联脚本恢复，避免闪白 */
  const toggle = document.querySelector('[data-theme-toggle]');
  toggle?.addEventListener('click', () => {
    const root = document.documentElement;
    const dark = !root.classList.contains('dark');
    root.classList.toggle('dark', dark);
    root.classList.toggle('light', !dark);
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    } catch {
      /* 隐私模式下忽略 */
    }
  });

  /* 移动端菜单 */
  const navToggle = document.querySelector('[data-nav-toggle]');
  const nav = document.querySelector('[data-nav]');
  navToggle?.addEventListener('click', () => {
    if (!nav) return;
    const open = nav.getAttribute('data-open') === 'true';
    nav.setAttribute('data-open', open ? 'false' : 'true');
    navToggle.setAttribute('aria-expanded', open ? 'false' : 'true');
  });
</script>
