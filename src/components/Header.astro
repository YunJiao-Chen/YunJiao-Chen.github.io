---
/**
 * 顶栏：与 PaperMod 的 _partials/header.html 结构一致
 *   header.header > nav.header-nav
 *     div.logo > a（站名）+ div.logo-switches > button#theme-toggle（月亮 / 太阳）+ span.nav-sep（|）
 *     ul#menu.menu > li > a > span[.active]（或 li > button.menu-search）
 * 说明：
 *   - 站名取 site.label，与 <title> 用的 site.title 分开（主题本来就这么分）
 *   - 菜单顺序完全由 site.config.ts 的 nav 决定，搜索是 type: 'search' 的条目
 *   - 主题靠 .menu 的横向滚动适配窄屏，不加汉堡按钮
 */
import Icon from './Icon.astro';
import SearchDialog from './SearchDialog.astro';
import { siteConfig, withBase } from '../../site.config.ts';

const { pathname } = Astro.url;
const base = siteConfig.site.base.replace(/\/$/, '');
const label = siteConfig.site.label || siteConfig.site.title;

/** 去掉 base 与末尾斜杠，便于比较当前路由 */
const normalize = (value: string) => {
  const stripped = value.startsWith(base) ? value.slice(base.length) : value;
  return stripped.endsWith('/') ? stripped : `${stripped}/`;
};

const currentPath = normalize(pathname);
const isActive = (href: string) => {
  const target = normalize(href);
  if (target === '/') return currentPath === '/';
  return currentPath === target || currentPath.startsWith(target);
};

/**
 * 菜单里没有 Home 项，站名本身就是回首页的链接，
 * 所以「当前在首页」这个状态落在站名上，样式与 .menu .active 一致。
 */
const isHome = currentPath === '/';
---

<header class="header">
  <nav class="header-nav">
    <div class="logo">
      <a
        href={withBase('/')}
        accesskey="h"
        title={`${label} (Alt + H)`}
        aria-current={isHome ? 'page' : undefined}
      >
        {/* active 落在 span 上，与菜单里的 .menu .active 同一套写法 */}
        <span class={isHome ? 'active' : undefined}>{label}</span>
      </a>
      {
        siteConfig.features.darkMode && (
          <div class="logo-switches">
            <button
              id="theme-toggle"
              class="theme-toggle"
              accesskey="t"
              title="(Alt + T)"
              aria-label="切换主题"
            >
              <Icon name="moon" size={17} class="moon" />
              <Icon name="sun" size={17} class="sun" />
            </button>
            {/* 主题的 .nav-sep：分隔品牌区与右侧菜单，与参考站一致 */}
            <span class="nav-sep" aria-hidden="true">
              |
            </span>
          </div>
        )
      }
    </div>

    <ul id="menu" class="menu">
      {
        siteConfig.nav.map((item) =>
          item.type === 'search' ? (
            <li>
              <button
                type="button"
                class="menu-search"
                data-search-open
                accesskey="/"
                title={`${item.label} (Alt + /)`}
              >
                <span>{item.label}</span>
              </button>
            </li>
          ) : (
            <li>
              <a
                href={withBase(item.href!)}
                title={item.label}
                aria-current={isActive(item.href!) ? 'page' : undefined}
              >
                <span class={isActive(item.href!) ? 'active' : undefined}>{item.label}</span>
              </a>
            </li>
          ),
        )
      }
    </ul>
  </nav>
</header>

<SearchDialog />

<script>
  /* 主题切换：与 PaperMod 的 footer.html 一致（data-theme 属性 + pref-theme 键） */
  const toggle = document.getElementById('theme-toggle');
  toggle?.addEventListener('click', () => {
    const html = document.documentElement;
    if (html.dataset.theme === 'dark') {
      html.dataset.theme = 'light';
      localStorage.setItem('pref-theme', 'light');
    } else {
      html.dataset.theme = 'dark';
      localStorage.setItem('pref-theme', 'dark');
    }
  });
</script>
