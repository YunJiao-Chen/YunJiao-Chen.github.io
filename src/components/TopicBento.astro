---
/**
 * 分类 Bento：5 个分类 = 5 个格子（1 个带真实配图的大格 + 4 个文字格）
 * 规则：格子数必须等于内容数，不留空格；至少 2 个格子有真实视觉差异。
 */
import type { Post } from '../lib/posts.ts';
import { coverUrl } from '../lib/images.ts';
import { withBase, type Category } from '../../site.config.ts';

interface Props {
  categories: (Category & { count: number; latest?: Post })[];
}

const { categories } = Astro.props;
const [lead, ...rest] = categories;
const leadCover = coverUrl(lead?.latest);
---

<div class="bento">
  {
    lead && (
      <a class="bento__cell bento__cell--lead" href={withBase(`/categories/${lead.slug}/`)} data-reveal>
        {leadCover && (
          <img src={leadCover} alt="" width="1600" height="1000" loading="lazy" decoding="async" />
        )}
        <span class="bento__body">
          <span class="bento__name">{lead.name}</span>
          <span class="bento__count">{lead.count} 篇</span>
          <span class="bento__desc">{lead.description}</span>
        </span>
      </a>
    )
  }

  {
    rest.map((category) => (
      <a class="bento__cell" href={withBase(`/categories/${category.slug}/`)} data-reveal>
        <span class="bento__name">{category.name}</span>
        <span class="bento__count">{category.count} 篇</span>
        <span class="bento__desc">{category.description}</span>
        {category.latest && <span class="bento__latest">最近：{category.latest.data.title}</span>}
      </a>
    ))
  }
</div>
