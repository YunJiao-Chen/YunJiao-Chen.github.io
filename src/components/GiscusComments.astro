---
/**
 * giscus 评论实现（GitHub Discussions 托管）
 * 主题跟随站点深浅色自动切换
 */
import { siteConfig } from '../../site.config.ts';

const { giscus } = siteConfig.comments;
---

<div
  class="giscus-host"
  data-giscus
  data-repo={giscus.repo}
  data-repo-id={giscus.repoId}
  data-category={giscus.category}
  data-category-id={giscus.categoryId}
  data-mapping={giscus.mapping}
  data-strict={giscus.strict ? '1' : '0'}
  data-reactions={giscus.reactionsEnabled ? '1' : '0'}
  data-input-position={giscus.inputPosition}
  data-lang={giscus.lang}
></div>

<script>
  const host = document.querySelector<HTMLElement>('[data-giscus]');

  function currentTheme() {
    return document.documentElement.classList.contains('dark') ? 'dark' : 'light';
  }

  if (host) {
    const script = document.createElement('script');
    script.src = 'https://giscus.app/client.js';
    script.async = true;
    script.crossOrigin = 'anonymous';
    script.setAttribute('data-repo', host.dataset.repo ?? '');
    script.setAttribute('data-repo-id', host.dataset.repoId ?? '');
    script.setAttribute('data-category', host.dataset.category ?? '');
    script.setAttribute('data-category-id', host.dataset.categoryId ?? '');
    script.setAttribute('data-mapping', host.dataset.mapping ?? 'pathname');
    script.setAttribute('data-strict', host.dataset.strict ?? '0');
    script.setAttribute('data-reactions-enabled', host.dataset.reactions ?? '1');
    script.setAttribute('data-emit-metadata', '0');
    script.setAttribute('data-input-position', host.dataset.inputPosition ?? 'top');
    script.setAttribute('data-theme', currentTheme());
    script.setAttribute('data-lang', host.dataset.lang ?? 'zh-CN');
    script.setAttribute('data-loading', 'lazy');
    host.appendChild(script);

    /* 主题切换时通知 iframe */
    const observer = new MutationObserver(() => {
      const frame = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
      frame?.contentWindow?.postMessage(
        { giscus: { setConfig: { theme: currentTheme() } } },
        'https://giscus.app',
      );
    });
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
  }
</script>
