---
/**
 * 列表分页：与 PaperMod 的 list.html 一致
 *   footer.page-footer > nav.pagination > a.prev / a.next
 */
import { withBase } from '../../site.config.ts';

interface Props {
  current: number;
  totalPages: number;
  basePath: string;
}

const { current, totalPages, basePath } = Astro.props;
const root = basePath.replace(/\/$/, '');
const hrefFor = (page: number) =>
  page <= 1 ? withBase(`${root}/`) : withBase(`${root}/page/${page}/`);
---

{
  totalPages > 1 && (
    <footer class="page-footer">
      <nav class="pagination" aria-label="分页导航">
        {current > 1 && (
          <a class="prev" href={hrefFor(current - 1)} rel="prev">
            «&nbsp;上一页&nbsp;{current - 1}/{totalPages}
          </a>
        )}
        {current < totalPages && (
          <a class="next" href={hrefFor(current + 1)} rel="next">
            下一页&nbsp;{current + 1}/{totalPages}&nbsp;»
          </a>
        )}
      </nav>
    </footer>
  )
}
