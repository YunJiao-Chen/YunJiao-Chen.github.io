---
/**
 * 站内搜索：<dialog> + 构建期索引，纯前端过滤
 * 状态齐全（设计规范 §4.5 要求 loading / empty / error 三态）：
 *   加载中显示骨架行，索引拉取失败显示重试按钮，无结果给出可执行建议
 */
import Icon from './Icon.astro';
---

<button type="button" class="nav__link nav__link--button" data-search-open aria-label="搜索文章">
  搜索
</button>

<dialog class="search-dialog" data-search-dialog aria-label="站内搜索">
  <div class="search-dialog__panel">
    <div class="search-dialog__field">
      <Icon name="search" size={17} />
      <input
        type="search"
        class="search-dialog__input"
        placeholder="搜索标题、摘要、分类或标签"
        autocomplete="off"
        spellcheck="false"
        aria-label="搜索关键词"
        data-search-input
      />
      <kbd>Esc</kbd>
    </div>
    <div class="search-dialog__results" data-search-results></div>
    <div class="search-dialog__foot">
      <span><kbd>↑</kbd><kbd>↓</kbd> 选择</span>
      <span><kbd>Enter</kbd> 打开</span>
      <span><kbd>Esc</kbd> 关闭</span>
    </div>
  </div>
</dialog>

<style>
  .search-dialog {
    margin: 12vh auto auto;
    padding: 0;
    width: 100%;
    max-width: min(94vw, 40rem);
    border: none;
    background: transparent;
    color: var(--text);
  }

  .search-dialog::backdrop {
    background: rgb(8 12 20 / 55%);
    backdrop-filter: blur(3px);
  }

  .search-dialog__panel {
    overflow: hidden;
    background: var(--bg);
    border: var(--hairline);
    border-radius: var(--radius-container);
    box-shadow: 0 24px 60px -30px rgb(0 0 0 / 35%);
  }

  .search-dialog__field {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    padding: var(--sp-4);
    border-bottom: var(--hairline);
    color: var(--text-subtle);
  }

  .search-dialog__input {
    flex: 1;
    border: none;
    background: transparent;
    color: var(--text);
    font: inherit;
    outline: none;
  }

  .search-dialog__results {
    display: grid;
    gap: var(--sp-1);
    max-height: min(52vh, 26rem);
    overflow-y: auto;
    padding: var(--sp-3);
  }

  .search-dialog__foot {
    display: flex;
    gap: var(--sp-5);
    padding: var(--sp-3) var(--sp-4);
    border-top: var(--hairline);
    color: var(--text-subtle);
    font-size: var(--fs-caption);
  }

  .search-dialog__foot span {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
  }
</style>

<style is:global>
  .search-result {
    display: grid;
    gap: 0.15rem;
    padding: var(--sp-3);
    border-radius: var(--radius-control);
  }

  .search-result[data-active='true'],
  .search-result:hover {
    background: var(--accent-weak);
  }

  .search-result__title {
    font-size: var(--fs-sm);
    font-weight: 600;
  }

  .search-result__desc {
    color: var(--text-muted);
    font-size: var(--fs-caption);
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .search-result__meta {
    font-family: var(--font-mono);
    color: var(--text-subtle);
    font-size: var(--fs-caption);
  }

  .search-state {
    display: grid;
    justify-items: center;
    gap: var(--sp-3);
    padding: var(--sp-6) var(--sp-4);
    text-align: center;
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }

  /* 加载骨架：形状与结果行一致（§4.5 不要转圈） */
  .search-skeleton {
    display: grid;
    gap: var(--sp-3);
    padding: var(--sp-3);
  }

  .search-skeleton span {
    height: 0.75rem;
    border-radius: 4px;
    background: linear-gradient(90deg, var(--surface) 0%, var(--border) 50%, var(--surface) 100%);
    background-size: 200% 100%;
    animation: search-shimmer 1.4s linear infinite;
  }

  .search-skeleton span:nth-child(2) {
    width: 70%;
  }

  .search-skeleton span:nth-child(4) {
    width: 84%;
  }

  @keyframes search-shimmer {
    from {
      background-position: 200% 0;
    }
    to {
      background-position: -200% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .search-skeleton span {
      animation: none;
    }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]');
  const input = dialog?.querySelector<HTMLInputElement>('[data-search-input]');
  const results = dialog?.querySelector<HTMLElement>('[data-search-results]');
  const base = import.meta.env.BASE_URL.replace(/\/$/, '');

  interface IndexPost {
    id: string;
    title: string;
    description: string;
    url: string;
    categoryName: string;
    tags: string[];
    date: string;
    reading: number;
  }

  let index: IndexPost[] = [];
  let state: 'idle' | 'loading' | 'ready' | 'error' = 'idle';
  let active = 0;
  let current: IndexPost[] = [];

  const escapeHtml = (value: string) =>
    value.replace(/[&<>"']/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string,
    );

  function renderSkeleton() {
    if (!results) return;
    results.innerHTML = `<div class="search-skeleton"><span></span><span></span><span></span><span></span></div>`;
  }

  function renderError() {
    if (!results) return;
    results.innerHTML = `<div class="search-state">
      <p>文章索引加载失败，可能是网络问题。</p>
      <button type="button" class="btn btn--ghost" data-search-retry>重新加载</button>
    </div>`;
    results.querySelector('[data-search-retry]')?.addEventListener('click', () => {
      state = 'idle';
      void ensureIndex();
    });
  }

  function renderEmpty() {
    if (!results) return;
    const hasQuery = Boolean(input?.value.trim());
    results.innerHTML = `<div class="search-state">
      <p>${hasQuery ? '没有匹配的文章，试试更短的关键词。' : '输入标题、摘要、分类或标签的关键词。'}</p>
    </div>`;
  }

  function render() {
    if (!results) return;
    if (state === 'loading') return renderSkeleton();
    if (state === 'error') return renderError();
    if (!current.length) return renderEmpty();
    results.innerHTML = current
      .map(
        (post, i) => `
        <a class="search-result" href="${base}${post.url}" data-index="${i}" ${
          i === active ? 'data-active="true"' : ''
        }>
          <span class="search-result__title">${escapeHtml(post.title)}</span>
          <span class="search-result__desc">${escapeHtml(post.description)}</span>
          <span class="search-result__meta">${post.date} / ${escapeHtml(post.categoryName)} / ${post.reading} 分钟</span>
        </a>`,
      )
      .join('');
  }

  async function ensureIndex() {
    if (state === 'ready' || state === 'loading') return;
    state = 'loading';
    render();
    try {
      const res = await fetch(`${base}/search-index.json`);
      if (!res.ok) throw new Error(String(res.status));
      const data = (await res.json()) as { posts: IndexPost[] };
      index = data.posts ?? [];
      state = 'ready';
      update();
    } catch {
      state = 'error';
      render();
    }
  }

  function score(post: IndexPost, terms: string[]) {
    const haystack = [post.title, post.description, post.tags.join(' '), post.categoryName]
      .join(' ')
      .toLowerCase();
    let total = 0;
    for (const term of terms) {
      if (!haystack.includes(term)) return 0;
      if (post.title.toLowerCase().includes(term)) total += 4;
      if (post.tags.some((t) => t.toLowerCase().includes(term))) total += 2;
      total += 1;
    }
    return total;
  }

  function update() {
    if (state !== 'ready') return;
    const value = (input?.value ?? '').trim().toLowerCase();
    if (!value) {
      current = index.slice(0, 6);
    } else {
      const terms = value.split(/\s+/).filter(Boolean);
      current = index
        .map((post) => ({ post, s: score(post, terms) }))
        .filter((entry) => entry.s > 0)
        .sort((a, b) => b.s - a.s || (a.post.date < b.post.date ? 1 : -1))
        .slice(0, 12)
        .map((entry) => entry.post);
    }
    active = 0;
    render();
  }

  async function open() {
    if (!dialog) return;
    if (!dialog.open) dialog.showModal();
    await ensureIndex();
    requestAnimationFrame(() => input?.focus());
  }

  function move(delta: number) {
    if (!current.length) return;
    active = (active + delta + current.length) % current.length;
    render();
    results?.querySelector('[data-active="true"]')?.scrollIntoView({ block: 'nearest' });
  }

  document.querySelectorAll('[data-search-open]').forEach((button) => {
    button.addEventListener('click', (event) => {
      event.preventDefault();
      void open();
    });
  });

  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });

  input?.addEventListener('input', update);

  dialog?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowDown') {
      event.preventDefault();
      move(1);
    } else if (event.key === 'ArrowUp') {
      event.preventDefault();
      move(-1);
    } else if (event.key === 'Enter') {
      const target = current[active];
      if (target) {
        event.preventDefault();
        window.location.href = `${base}${target.url}`;
      }
    }
  });

  results?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) dialog?.close();
  });

  document.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      void open();
    }
  });
</script>
