---
/**
 * 页脚：与参考站一致，居中极简（社交图标 + 版权 + 构建说明）
 * 导航统一放在顶栏，页脚不再重复导航
 */
import Icon from './Icon.astro';
import { siteConfig, withBase } from '../../site.config.ts';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="social-icons">
    {
      siteConfig.author.socials.map((social) => (
        <a
          href={social.href.startsWith('/') ? withBase(social.href) : social.href}
          rel="noopener"
          title={social.label}
          aria-label={social.label}
        >
          <Icon name={social.icon} size={26} />
        </a>
      ))
    }
    {
      siteConfig.features.rss && (
        <a href={withBase('/rss.xml')} title="RSS 订阅" aria-label="RSS 订阅">
          <Icon name="rss" size={26} />
        </a>
      )
    }
  </div>

  <div class="footer__bottom">
    <span>© {siteConfig.footer.since} {year} {siteConfig.author.name}</span>
    <span>{siteConfig.footer.note}</span>
  </div>
</footer>
