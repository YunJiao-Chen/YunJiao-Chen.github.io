---
/**
 * 页脚：与 PaperMod 的 _partials/footer.html 一致
 *   两段居中单行：版权 + 来源说明，另加一个回到顶部按钮
 *   参考站渲染出来是「© 2026 Lil'Log Powered by Hugo & PaperMod」，
 *   两段之间没有分隔符（模板里的「 · 」在她那版里没有输出），这里照做。
 *   来源写 Astro & PaperMod 是实话：本站用 Astro 构建，只移植了 PaperMod 的样式。
 * 许可协议等长文案放在关于页，页脚保持主题那样的短行。
 */
import { siteConfig, withBase } from '../../site.config.ts';

const year = new Date().getFullYear();
---

<footer class="footer">
  <span>&copy; {year} <a href={withBase('/')}>{siteConfig.site.title}</a></span>{' '}
  <span>
    Powered by <a href="https://astro.build" rel="noopener" target="_blank">Astro</a> &amp;{' '}
    <a href="https://github.com/adityatelange/hugo-PaperMod/" rel="noopener" target="_blank"
      >PaperMod</a
    >
  </span>
</footer>

<a
  href="#top"
  id="top-link"
  class="top-link hidden"
  aria-label="回到顶部"
  title="回到顶部 (Alt + G)"
  accesskey="g"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <polyline points="17 11 12 6 7 11"></polyline>
    <polyline points="17 18 12 13 7 18"></polyline>
  </svg>
</a>

<script>
  /* 回到顶部：主题用 scroll 监听控制显隐，这里换成 IntersectionObserver，
     观察顶栏是否还在视口里（看得到顶栏就说明没滚下去，按钮隐藏） */
  const topLink = document.getElementById('top-link');
  const header = document.querySelector('.header');
  if (topLink && header && 'IntersectionObserver' in window) {
    new IntersectionObserver(
      ([entry]) => {
        topLink.classList.toggle('hidden', entry.isIntersecting);
      },
      { threshold: 0 },
    ).observe(header);
  }
</script>
