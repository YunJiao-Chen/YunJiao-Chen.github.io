---
/**
 * 页脚：订阅带 + 站点信息 / 导航 / 分类
 * 不放构建版本号与时间戳（设计规范 §9.F 禁止 devtool 风格的版本页脚）
 */
import Icon from './Icon.astro';
import Subscribe from './Subscribe.astro';
import { siteConfig, withBase } from '../../site.config.ts';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <Subscribe />

    <a class="brand footer__brand" href={withBase('/')}>
      <span class="brand__mark" aria-hidden="true">{siteConfig.author.name.slice(0, 1)}</span>
      <span class="brand__text">
        <span class="brand__title">{siteConfig.site.title}</span>
        <span class="brand__subtitle">{siteConfig.site.subtitle}</span>
      </span>
    </a>

    <div class="footer__grid">
      <div>
        <p class="footer__intro">{siteConfig.site.description}</p>
        <div class="footer__social">
          {
            siteConfig.author.socials.map((social) => (
              <a
                href={social.href.startsWith('/') ? withBase(social.href) : social.href}
                rel="noopener"
              >
                <Icon name={social.icon} size={15} />
                {social.label}
              </a>
            ))
          }
        </div>
      </div>

      <div>
        <p class="footer__title">导航</p>
        <ul class="footer__list">
          {
            siteConfig.nav.map((item) => (
              <li>
                <a href={withBase(item.href)}>{item.label}</a>
              </li>
            ))
          }
          {
            siteConfig.features.rss && (
              <li>
                <a href={withBase('/rss.xml')}>RSS</a>
              </li>
            )
          }
        </ul>
      </div>

      <div>
        <p class="footer__title">分类</p>
        <ul class="footer__list">
          {
            siteConfig.categories.map((category) => (
              <li>
                <a href={withBase(`/categories/${category.slug}/`)}>{category.name}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <span>
        © {siteConfig.footer.since} {year} {siteConfig.author.name}
        {siteConfig.footer.icp && ` / ${siteConfig.footer.icp}`}
      </span>
      <span>{siteConfig.footer.note}</span>
    </div>
  </div>
</footer>
