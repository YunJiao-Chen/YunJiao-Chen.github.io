---
/**
 * 页脚（PaperMod 是居中极简：社交图标 + 版权）
 * 这里保留此前的 3 行导航（关于 / 导航 / 分类），但按同样的克制样式：居中、小字、hairline
 */
import Icon from './Icon.astro';
import { siteConfig, withBase } from '../../site.config.ts';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__rows">
    <div class="footer__row">
      <p class="footer__label">关于</p>
      <div class="footer__social">
        {
          siteConfig.author.socials.map((social) => (
            <a href={social.href.startsWith('/') ? withBase(social.href) : social.href} rel="noopener">
              <Icon name={social.icon} size={14} />
              {social.label}
            </a>
          ))
        }
      </div>
    </div>

    <div class="footer__row">
      <p class="footer__label">导航</p>
      <ul class="footer__list">
        {
          siteConfig.nav.map((item) => (
            <li>
              <a href={withBase(item.href)}>{item.label}</a>
            </li>
          ))
        }
        {
          siteConfig.features.rss && (
            <li>
              <a href={withBase('/rss.xml')}>RSS</a>
            </li>
          )
        }
      </ul>
    </div>

    <div class="footer__row">
      <p class="footer__label">分类</p>
      <ul class="footer__list">
        {
          siteConfig.categories.map((category) => (
            <li>
              <a href={withBase(`/categories/${category.slug}/`)}>{category.name}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="footer__bottom">
    <span>© {siteConfig.footer.since} {year} {siteConfig.author.name}</span>
    <span>{siteConfig.footer.note}</span>
  </div>
</footer>
