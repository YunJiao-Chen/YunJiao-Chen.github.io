---
/**
 * 条目卡片：与 PaperMod 的 list.html 里 post-entry 的结构一致
 *   article.post-entry
 *     div.entry-cover（可选）
 *     header.entry-header > h2.entry-hint-parent
 *     div.entry-content > p
 *     footer.entry-footer（日期 · 阅读时间）
 *     a.entry-link（覆盖整张卡片，负责点击跳转）
 */
import { postPath, postMeta, type Post } from '../lib/posts.ts';
import { formatDate } from '../lib/utils.ts';
import { coverUrl } from '../lib/images.ts';
import { siteConfig, withBase } from '../../site.config.ts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const meta = postMeta(post);
const cover = coverUrl(post);
const href = withBase(postPath(post));

/* 与主题的 post_meta.html 一致：用不换行空格 + 中点拼接 */
const dateHtml = `<span>${formatDate(post.data.pubDate)}</span>`;
const readingHtml = siteConfig.features.readingTime
  ? `<span>${meta.reading.label}</span>`
  : '';
const metaHtml = [dateHtml, readingHtml].filter(Boolean).join('&nbsp;&middot;&nbsp;');
---

<article class="post-entry">
  {
    cover && (
      <div class="entry-cover">
        <img src={cover} alt="" width="480" height="240" loading="lazy" decoding="async" />
      </div>
    )
  }

  <header class="entry-header">
    <h2 class="entry-hint-parent">{post.data.title}</h2>
  </header>

  <div class="entry-content">
    <p>{post.data.description}</p>
  </div>

  <footer class="entry-footer" set:html={metaHtml} />

  <a class="entry-link" aria-label={`文章：${post.data.title}`} href={href}></a>
</article>
