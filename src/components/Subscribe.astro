---
/**
 * 订阅带：RSS + 公众号二维码（单条横幅，不套卡片）
 * 二维码放 public/qrcode.png（或 jpg / svg / webp）即自动显示，同时给出应用图标占位。
 */
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';

import Icon from './Icon.astro';
import { siteConfig, withBase } from '../../site.config.ts';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;

const qrcode = ['png', 'jpg', 'jpeg', 'svg', 'webp']
  .map((ext) => `/qrcode.${ext}`)
  .find((file) => existsSync(fileURLToPath(new URL(`../../public${file}`, import.meta.url))));
---

<section class="band" id="subscribe" aria-label="订阅更新">
  <div>
    <h2 class="band__title">订阅更新</h2>
    <p class="band__desc">
      RSS 阅读器订阅全部文章，或关注公众号「{siteConfig.wechat.accountName}」接收推送。
      {!compact && '新文章会同步到两边。'}
    </p>
  </div>

  <div class="band__actions">
    {
      siteConfig.features.rss && (
        <a class="btn btn--primary" href={withBase('/rss.xml')}>
          <Icon name="rss" size={15} /> 订阅 RSS
        </a>
      )
    }
    <a class="btn btn--ghost" href={withBase('/about/')}>
      <Icon name="mail" size={15} /> 联系我
    </a>
    {
      qrcode ? (
        <img
          class="band__qr"
          src={withBase(qrcode)}
          alt={`公众号「${siteConfig.wechat.accountName}」二维码`}
          width="88"
          height="88"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <span class="band__qr band__qr--empty">
          <Icon name="qrcode" size={22} label="公众号二维码占位" />
        </span>
      )
    }
  </div>
</section>
