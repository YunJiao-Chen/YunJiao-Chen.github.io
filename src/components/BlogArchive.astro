---
/**
 * 文章列表主体：条目卡片 + 分页
 */
import ArchiveList from './ArchiveList.astro';
import Pagination from './Pagination.astro';
import type { Post } from '../lib/posts.ts';

interface Props {
  items: Post[];
  current: number;
  totalPages: number;
  total: number;
}

const { items, current, totalPages, total } = Astro.props;
---

<ArchiveList posts={items} emptyText="还没有文章：在 src/content/blog/ 下新建一篇 Markdown 即可。" />

<Pagination current={current} totalPages={totalPages} basePath="/posts" />

<p class="post-meta">共 {total} 篇，第 {current} / {totalPages} 页</p>
