---
/**
 * 归档列表：单列条目卡片（PaperMod 的 post-entry 列表）
 */
import PostEntry from './PostEntry.astro';
import type { Post } from '../lib/posts.ts';
import { withBase } from '../../site.config.ts';

interface Props {
  posts: Post[];
  emptyText?: string;
}

const { posts, emptyText = '这里还没有文章。' } = Astro.props;
---

{
  posts.length === 0 ? (
    <div class="empty">
      <p>{emptyText}</p>
      <p>
        <a class="text-link" href={withBase('/posts/')}>
          去看全部文章
        </a>
      </p>
    </div>
  ) : (
    posts.map((post) => <PostEntry post={post} />)
  )
}
