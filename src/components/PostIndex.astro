---
/**
 * 双栏媒体行列表（条目多于 5 条时使用，避免单列 hairline 长列表）
 * 每条带 4:3 缩略图，让连续的文字区块有图像节奏
 */
import { postPath, postMeta, type Post } from '../lib/posts.ts';
import { formatDate } from '../lib/utils.ts';
import { coverUrl } from '../lib/images.ts';
import { withBase } from '../../site.config.ts';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<div class="index-list">
  {
    posts.map((post) => {
      const cover = coverUrl(post);
      const meta = postMeta(post);
      return (
        <a class="index-item" href={withBase(postPath(post))} data-reveal>
          {cover && (
            <span class="index-item__thumb">
              <img src={cover} alt="" width="1600" height="1200" loading="lazy" decoding="async" />
            </span>
          )}
          <span class="index-item__body">
            <span class="index-item__date">
              {formatDate(post.data.pubDate)} / {meta.category.name}
            </span>
            <span class="index-item__title">{post.data.title}</span>
            <span class="index-item__dek">{post.data.description}</span>
          </span>
        </a>
      );
    })
  }
</div>
