---
/**
 * 评论 Provider 抽象层
 * ---------------------------------------------------------------------------
 * 页面只引用本组件，不关心具体实现：
 *   provider = 'none'   → 占位说明（默认，零请求）
 *   provider = 'giscus' → 注入 GitHub Discussions 评论（需 repoId / categoryId）
 * 新增实现（Waline / Twikoo）时在这里加一个分支即可。
 */
import GiscusComments from './GiscusComments.astro';
import { siteConfig } from '../../site.config.ts';

const { provider, giscus } = siteConfig.comments;
const giscusReady = provider === 'giscus' && Boolean(giscus.repoId) && Boolean(giscus.categoryId);
---

<section class="comments" id="comments" data-wechat-ignore>
  <div class="section-head">
    <div>
      <h2 class="section-head__title">评论与讨论</h2>
      <p class="section-head__desc">
        {
          giscusReady
            ? '评论由 GitHub Discussions 托管，使用 GitHub 账号即可参与。'
            : '评论暂未开启：本站是纯静态站点，采用无后端方案，不需要服务器与数据库。'
        }
      </p>
    </div>
  </div>

  {
    giscusReady ? (
      <GiscusComments />
    ) : (
      <div class="comments__placeholder">
        <p>开启只需三步（配置项在 <code>site.config.ts</code> 的 <code>comments</code>）：</p>
        <ol class="comments__steps">
          <li>为仓库开启 Discussions，并新建一个分类（如 Announcements）。</li>
          <li>
            到 <a href="https://giscus.app/zh-CN" rel="noopener">giscus.app</a> 填入仓库信息，
            分别复制 <code>data-repo-id</code> 与 <code>data-category-id</code>。
          </li>
          <li>
            把 <code>comments.provider</code> 改为 <code>'giscus'</code>，填入上面两个 ID。
          </li>
        </ol>
        <p>
          完整步骤见仓库内 <code>docs/COMMENTS.md</code>；切换实现不需要改动任何页面代码。
        </p>
      </div>
    )
  }
</section>
