---
/**
 * 评论 Provider 抽象层
 * ---------------------------------------------------------------------------
 * 页面只引用本组件，不关心具体实现：
 *   provider = 'none'   → 只显示联系入口
 *   provider = 'giscus' → GitHub Discussions 评论（需 repoId 与 categoryId 齐全）
 * 新增实现（Waline / Twikoo）时在这里加一个分支即可。
 */
import GiscusComments from './GiscusComments.astro';
import { siteConfig, withBase } from '../../site.config.ts';

const { provider, giscus } = siteConfig.comments;
/** 两个 ID 都齐全才认为 giscus 就绪，避免渲染出坏掉的 iframe */
const giscusReady = provider === 'giscus' && Boolean(giscus.repoId) && Boolean(giscus.categoryId);
const { author } = siteConfig;
const github = author.socials.find((s) => s.icon === 'github');
---

<section class="comments" id="comments" data-wechat-ignore>
  <div class="section-head">
    <h2 class="section-head__title">评论与讨论</h2>
    <p class="section-head__desc">
      {
        giscusReady
          ? '评论由 GitHub Discussions 托管，用 GitHub 账号即可参与，不需要注册新账号。'
          : '评论区还没有开放。想讨论文章里的问题，欢迎直接找我。'
      }
    </p>
  </div>

  {
    giscusReady ? (
      <GiscusComments />
    ) : (
      <div class="comments__placeholder">
        <p>
          可以发邮件到 <a href={`mailto:${author.email}`}>{author.email}</a>
          {github && (
            <>
              ，或者到 <a href={github.href} rel="noopener">GitHub</a> 提 issue
            </>
          )}
          ，我都会看。
        </p>
      </div>
    )
  }
</section>
