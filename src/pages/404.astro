---
/**
 * 404 页面（GitHub Pages 使用 dist/404.html）
 */
import PageLayout from '../layouts/PageLayout.astro';
import { withBase } from '../../site.config.ts';
---

<PageLayout
  title="这个地址没有内容"
  description="链接可能过期，或者文章改了名字。"
  path="/404"
  kind="page"
  prose
  noindex
>
  <ul>
    <li><a href={withBase('/')}>返回首页</a></li>
    <li><a href={withBase('/posts/')}>浏览全部文章</a></li>
    <li><a href={withBase('/categories/')}>按分类查找</a></li>
    <li><a href={withBase('/tags/')}>按标签查找</a></li>
  </ul>
  <p>也可以按 <kbd>⌘K</kbd> 或 <kbd>Ctrl+K</kbd> 打开站内搜索。</p>
</PageLayout>
