---
/**
 * 单标签归档：/tags/<tag>/
 */
import type { GetStaticPaths } from 'astro';

import PageLayout from '../../layouts/PageLayout.astro';
import ArchiveList from '../../components/ArchiveList.astro';
import TagField from '../../components/TagField.astro';
import { getPostsByTag, getTagSummaries, type Post } from '../../lib/posts.ts';

export const getStaticPaths: GetStaticPaths = async () => {
  const tags = await getTagSummaries();
  return Promise.all(
    tags.map(async (tag) => ({
      params: { tag: tag.slug },
      props: { tag, posts: await getPostsByTag(tag.name) },
    })),
  );
};

interface Props {
  tag: { name: string; count: number; slug: string };
  posts: Post[];
}

const { tag, posts } = Astro.props;
const tags = await getTagSummaries();
---

<PageLayout
  title={tag.name}
  description={`共 ${posts.length} 篇文章。`}
  path={`/tags/${tag.slug}/`}
>
  <ArchiveList posts={posts} emptyText={`标签「${tag.name}」下还没有文章。`} />

  <header class="entry-header">
    <h2>其他标签</h2>
  </header>
  <TagField tags={tags.filter((item) => item.name !== tag.name)} limit={24} />
</PageLayout>
