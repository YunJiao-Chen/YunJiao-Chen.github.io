---
/**
 * 标签总览：/tags/
 */
import PageLayout from '../../layouts/PageLayout.astro';
import TagField from '../../components/TagField.astro';
import ArchiveList from '../../components/ArchiveList.astro';
import { getAllPosts, getTagSummaries } from '../../lib/posts.ts';

const [tags, posts] = await Promise.all([getTagSummaries(), getAllPosts()]);
---

<PageLayout
  title="标签"
  description={`共 ${tags.length} 个标签，按出现次数排序。`}
  path="/tags/"
  listPage
>
  {tags.length > 0 ? <TagField tags={tags} /> : <p>还没有标签。</p>}

  <header class="entry-header">
    <h2>全部文章</h2>
  </header>
  <ArchiveList posts={posts} />
</PageLayout>
