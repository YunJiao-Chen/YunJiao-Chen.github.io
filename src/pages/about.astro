---
/**
 * 关于我（PaperMod 的内容页：窄栏 + 正文 + 事实列表）
 */
import PageLayout from '../layouts/PageLayout.astro';
import PostEntry from '../components/PostEntry.astro';
import { getLatestPosts } from '../lib/posts.ts';
import { portraitUrl } from '../lib/images.ts';
import { siteConfig, withBase } from '../../site.config.ts';

const { author } = siteConfig;
const latest = await getLatestPosts(3);
const portrait = portraitUrl('portrait');
---

<PageLayout title={`关于 ${author.name}`} description={author.tagline} path="/about/">
  <div class="about">
    <div class="prose">
      <p>{author.bio[0]}</p>
      <p>{author.bio[1]}</p>
      <p>{author.bio[2]}</p>

      <h2>这个博客写什么</h2>
      <p>内容按 {siteConfig.categories.length} 个固定分类组织：</p>
      <ul>
        {
          siteConfig.categories.map((category) => (
            <li>
              <a href={withBase(`/categories/${category.slug}/`)}>{category.name}</a>
              ：{category.description}
            </li>
          ))
        }
      </ul>

      <h2>怎么写</h2>
      <ul>
        <li>
          用 Markdown 写作，站点用 <a href="https://astro.build" rel="noopener">Astro</a>
          构建成静态页面，源码托管在 GitHub。
        </li>
        <li>
          每篇文章都能一键转成公众号排版，文末的「复制到公众号」按钮会把样式内联后写进剪贴板。
        </li>
        <li>写作原则：能跑通再说，给出取舍而不只是结论，标注不确定的地方。</li>
      </ul>

      <h2>联系我</h2>
      <ul>
        {
          author.socials.map((social) => (
            <li>
              <a href={social.href.startsWith('/') ? withBase(social.href) : social.href} rel="noopener">
                {social.label}
              </a>
              {social.icon === 'mail' && `：${author.email}`}
            </li>
          ))
        }
      </ul>
    </div>

    <aside class="about__side">
      {
        portrait && (
          <img
            class="about__portrait"
            src={portrait}
            alt={`${author.name} 的照片`}
            width="1200"
            height="1500"
            loading="lazy"
            decoding="async"
          />
        )
      }
      <dl class="fact-list">
        <div class="fact-list__row">
          <dt>职业</dt>
          <dd>{author.jobTitle}</dd>
        </div>
        <div class="fact-list__row">
          <dt>方向</dt>
          <dd>{author.focus.join('、')}</dd>
        </div>
      </dl>
    </aside>
  </div>

  <h2 class="subhead">最近更新</h2>
  {latest.map((post) => <PostEntry post={post} />)}
</PageLayout>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 13rem;
    gap: var(--gap);
    align-items: start;
  }

  .about__side {
    display: grid;
    gap: var(--sp-4);
  }

  .about__portrait {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-container);
  }

  @media (max-width: 768px) {
    .about {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
