---
/**
 * 主页：与 PaperMod 的 index/home_info + list.html 一致
 *   article.first-entry.home-info（标题 + 简介 + 社交图标）
 *   最新文章 post-entry 卡片
 *   footer.page-footer > nav.pagination（全部文章）
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PostEntry from '../components/PostEntry.astro';
import Icon from '../components/Icon.astro';

import { getAllPosts, getLatestPosts } from '../lib/posts.ts';
import { siteConfig, withBase } from '../../site.config.ts';

const posts = await getAllPosts();
const latest = await getLatestPosts(siteConfig.site.latestCount);
const { author } = siteConfig;
/** 社交链接里已经有 RSS 时不再重复渲染，避免页脚出现两个订阅图标 */
const hasRssSocial = author.socials.some((social) => social.icon === 'rss');
---

<BaseLayout description={siteConfig.site.description} path="/" listPage>
  <article class="first-entry home-info">
    <header class="entry-header">
      <h1>欢迎来到 {author.name}</h1>
    </header>
    <div class="entry-content md-content">
      <p>{author.lead}</p>
    </div>
    <footer class="entry-footer">
      <div class="social-icons">
        {
          author.socials.map((social) => (
            <a
              href={social.href.startsWith('/') ? withBase(social.href) : social.href}
              rel="noopener noreferrer me"
              title={social.label}
              aria-label={social.label}
            >
              <Icon name={social.icon} size={26} />
            </a>
          ))
        }
        {
          siteConfig.features.rss && !hasRssSocial && (
            <a href={withBase('/rss.xml')} title="RSS 订阅" aria-label="RSS 订阅">
              <Icon name="rss" size={26} />
            </a>
          )
        }
      </div>
    </footer>
  </article>

  {latest.map((post) => <PostEntry post={post} />)}

  <footer class="page-footer">
    <nav class="pagination" aria-label="全部文章">
      <a class="next" href={withBase('/posts/')}>全部 {posts.length} 篇&nbsp;»</a>
    </nav>
  </footer>
</BaseLayout>
