---
/**
 * 主页（PaperMod 结构）
 *   1 欢迎卡片（first-entry / home-info）：标题 + 简介 + 社交图标
 *   2 最新文章条目卡片（post-entry）
 *   3 「全部文章」链接
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PostEntry from '../components/PostEntry.astro';
import Icon from '../components/Icon.astro';

import { getAllPosts, getLatestPosts } from '../lib/posts.ts';
import { siteConfig, withBase } from '../../site.config.ts';

const posts = await getAllPosts();
const latest = await getLatestPosts(siteConfig.site.latestCount);
const { author } = siteConfig;
---

<BaseLayout description={siteConfig.site.description} path="/">
  {/* 1. 欢迎卡片 */}
  <article class="entry entry--info" data-reveal>
    <header class="entry__header">
      <h1 class="entry__title">你好，我是 {author.name}</h1>
    </header>
    <section class="entry__content">
      <p class="entry__summary">{author.lead}</p>
    </section>
    <footer class="entry__footer">
      <div class="social-icons">
        {
          author.socials.map((social) => (
            <a
              href={social.href.startsWith('/') ? withBase(social.href) : social.href}
              rel="noopener"
            >
              <Icon name={social.icon} size={16} />
              {social.label}
            </a>
          ))
        }
      </div>
    </footer>
  </article>

  {/* 2. 最新文章 */}
  {latest.map((post) => <PostEntry post={post} />)}

  {/* 3. 全部文章 */}
  <p>
    <a class="more-link" href={withBase('/posts/')}>
      全部 {posts.length} 篇<span aria-hidden="true">→</span>
    </a>
  </p>
</BaseLayout>
