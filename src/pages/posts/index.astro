---
/**
 * 文章列表（第 1 页）：/posts/
 */
import PageLayout from '../../layouts/PageLayout.astro';
import BlogArchive from '../../components/BlogArchive.astro';
import { getAllPosts, paginate } from '../../lib/posts.ts';

const posts = await getAllPosts();
const page = await paginate(posts, 1);
---

<PageLayout
  title="文章"
  description={`共 ${posts.length} 篇，按发布时间倒序。`}
  path="/posts/"
>
  <BlogArchive
    items={page.items}
    current={page.current}
    totalPages={page.totalPages}
    total={page.total}
  />
</PageLayout>
