---
/**
 * 分类总览：/categories/（PaperMod 归档风格：一行一个分类 + 篇数）
 */
import PageLayout from '../../layouts/PageLayout.astro';
import { getCategorySummaries } from '../../lib/posts.ts';
import { withBase } from '../../../site.config.ts';

const categories = await getCategorySummaries();
---

<PageLayout title="分类" description="每篇文章只归属一个分类，分类是站点的主干。" path="/categories/">
    {
      categories.map((category) => (
        <div class="entry">
          <h2 class="entry__title">
            <a href={withBase(`/categories/${category.slug}/`)}>{category.name}</a>
          </h2>
          <section class="entry__content">
            <p class="entry__summary">{category.description}</p>
          </section>
          <footer class="entry__footer">
            <span>{category.count} 篇</span>
            {category.latest && <span>最近 {category.latest.data.title}</span>}
          </footer>
        </div>
      ))
    }
</PageLayout>
