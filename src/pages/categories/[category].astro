---
/**
 * 单分类归档：/categories/<slug>/
 */
import type { GetStaticPaths } from 'astro';

import PageLayout from '../../layouts/PageLayout.astro';
import ArchiveList from '../../components/ArchiveList.astro';
import { getPostsByCategory, type Post } from '../../lib/posts.ts';
import { siteConfig, type Category } from '../../../site.config.ts';

export const getStaticPaths: GetStaticPaths = async () =>
  Promise.all(
    siteConfig.categories.map(async (category) => ({
      params: { category: category.slug },
      props: { category, posts: await getPostsByCategory(category.slug) },
    })),
  );

interface Props {
  category: Category;
  posts: Post[];
}

const { category, posts } = Astro.props;
---

<PageLayout
  title={category.name}
  description={`${category.description}共 ${posts.length} 篇。`}
  path={`/categories/${category.slug}/`}
>
  <ArchiveList posts={posts} emptyText={`「${category.name}」分类还没有文章。`} />
</PageLayout>
